<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the window behind the first frame uses the wallpaper-derived (Material You) neutral,
         so there is no flash of the fallback paper colour before Compose draws. -->
    <style name="Theme.ArCanvas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
